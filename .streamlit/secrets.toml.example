# Copy to secrets.toml for local use. On Streamlit Cloud paste into: App settings > Secrets.
# NEVER upload secrets.toml to GitHub.

# Gmail account that SENDS notification emails (use a Google "App password").
SMTP_USER = "admin@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx "

# Change the administrator password (default is admin123).
ADMIN_PASSWORD = "admin123xxxx"

# Optional: password of the demo warden account.
WARDEN_PASSWORD = "warden123"

# Optional: extra emails allowed to self-register as warden.
AUTHORIZED_WARDEN_EMAILS = ["yourname@gmail.com"]
